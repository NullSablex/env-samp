# ==============================
# env_samp - Exemplo de .env
# ==============================
# Este arquivo demonstra TUDO que o parser aceita.

# ------------------------------
# 1) Formato básico / espaços
# ------------------------------
# Sem espaços (também suportado)
APP_ENV=production
APP_DEBUG=false

# Com espaços (também suportado)
MYSQL_HOST = 127.0.0.1
MYSQL_PORT = 3306
MYSQL_USER = samp_user
MYSQL_PASS = 'senha forte aqui'
MYSQL_DB = samp
EMPTY_VALUE =

# ------------------------------
# 2) Aspas simples (literal)
# ------------------------------
LITERAL_TEXT = 'texto com \n e \t literal'

# ------------------------------
# 3) Aspas duplas (com escapes)
# ------------------------------
SERVER_NAME = "Meu Servidor SA:MP"
MOTD = "Linha 1\nLinha 2"
ESCAPED_QUOTES = "Ele disse: \"oi\""
WINDOWS_PATH = "C:\\samp\\plugins"

# ------------------------------
# 4) Comentários
# ------------------------------
# Linha iniciada com # é ignorada
SERVER_MODE = roleplay
SERVER_LANGUAGE = pt_BR
WITH_INLINE_COMMENT = valor # este comentário é ignorado
HASH_WITHOUT_SPACE = valor#isto_faz_parte_do_valor

# ------------------------------
# 5) Primeiro '=' separa chave/valor
# ------------------------------
DATABASE_URL = mysql://user:pass@127.0.0.1:3306/samp?opt=a=b=c

# ------------------------------
# 6) Chave duplicada (a última vence)
# ------------------------------
MAX_PLAYERS = 50
MAX_PLAYERS = 100

# ------------------------------
# 7) Tokens / segredos
# ------------------------------
API_TOKEN = "troque-este-token"
